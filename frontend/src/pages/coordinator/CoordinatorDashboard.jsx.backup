import {useState, useEffect, useCallback} from "react";
import {motion, AnimatePresence} from "framer-motion";
import {useNavigate} from "react-router-dom";
import {toast} from "react-toastify";
import jsPDF from "jspdf";
import autoTable from "jspdf-autotable";
import api from "../../config/api";

const CoordinatorDashboard = () => {
  const navigate = useNavigate();
  const [coordinator, setCoordinator] = useState(null);
  const [stats, setStats] = useState(null);
  const [registrations, setRegistrations] = useState([]);
  const [loading, setLoading] = useState(true);
  const [activeTab, setActiveTab] = useState("dashboard");
  const [filters, setFilters] = useState({
    page: 1,
    limit: 50,
    status: "",
    eventName: "",
    search: "",
  });

  const fetchDashboardData = useCallback(async (token) => {
    try {
      const statsRes = await api.get("/game-coordinator/dashboard/stats", {
        headers: {Authorization: `Bearer ${token}`},
      });
      setStats(statsRes.data.data);
    } catch (error) {
      console.error("Error fetching dashboard data:", error);
      if (error.response?.status === 401) {
        localStorage.removeItem("coordinatorToken");
        localStorage.removeItem("coordinatorData");
        navigate("/coordinator/login");
      }
    } finally {
      setLoading(false);
    }
  }, [navigate]);

  const fetchRegistrations = useCallback(async (token) => {
    try {
      const params = new URLSearchParams();
      Object.entries(filters).forEach(([key, value]) => {
        if (value) params.append(key, value);
      });

      const res = await api.get(`/game-coordinator/registrations?${params}`, {
        headers: {Authorization: `Bearer ${token}`},
      });
      setRegistrations(res.data.data);
    } catch (error) {
      console.error("Error fetching registrations:", error);
    }
  }, [filters]);

  useEffect(() => {
    const coordinatorData = localStorage.getItem("coordinatorData");
    if (!coordinatorData) {
      navigate("/coordinator/login");
      return;
    }
    
    setCoordinator(JSON.parse(coordinatorData));
    const token = localStorage.getItem("coordinatorToken");
    if (token) {
      fetchDashboardData(token);
      if (activeTab === "registrations") {
        fetchRegistrations(token);
      }
    }
  }, [navigate, fetchDashboardData, fetchRegistrations, activeTab]);

  const handleLogout = () => {
    localStorage.removeItem("coordinatorToken");
    localStorage.removeItem("coordinatorData");
    navigate("/coordinator/login");
  };

  const getStatusColor = (status) => {
    switch (status) {
      case "confirmed":
        return "text-green-400 bg-green-400/10 border-green-400/30";
      case "pending":
        return "text-yellow-400 bg-yellow-400/10 border-yellow-400/30";
      case "cancelled":
        return "text-red-400 bg-red-400/10 border-red-400/30";
      default:
        return "text-gray-400 bg-gray-400/10 border-gray-400/30";
    }
  };

  const getPaymentStatusColor = (status) => {
    switch (status) {
      case "approved":
        return "text-green-400 bg-green-400/10 border-green-400/30";
      case "pending":
        return "text-yellow-400 bg-yellow-400/10 border-yellow-400/30";
      case "rejected":
        return "text-red-400 bg-red-400/10 border-red-400/30";
      default:
        return "text-gray-400 bg-gray-400/10 border-gray-400/30";
    }
  };

  return (
    <div className="min-h-screen bg-gradient-to-br from-black via-[#0a0a18] to-black">
      {/* Header */}
      <div className="sticky top-0 z-50 bg-black/80 backdrop-blur-xl border-b border-gray-800">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex items-center justify-between h-16">
            <div className="flex items-center gap-4">
              <h1 className="text-2xl font-bold font-orbitron bg-gradient-to-r from-green-400 to-blue-500 bg-clip-text text-transparent">
                ZENITH 2026
              </h1>
              <span className="text-gray-500">|</span>
              <span className="text-gray-300 font-rajdhani">Game Coordinator</span>
            </div>
            <div className="flex items-center gap-4">
              <div className="text-right">
                <p className="text-sm text-gray-400">Coordinator</p>
                <p className="text-white font-semibold">{coordinator?.username}</p>
              </div>
              <button
                onClick={handleLogout}
                className="px-4 py-2 bg-red-500/10 border border-red-500/30 text-red-400 rounded-lg hover:bg-red-500/20 transition-all font-rajdhani"
              >
                Logout
              </button>
            </div>
          </div>
        </div>
      </div>

      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {loading ? (
          <div className="flex items-center justify-center py-12">
            <motion.div
              animate={{rotate: 360}}
              transition={{duration: 1, repeat: Infinity, ease: "linear"}}
              className="w-16 h-16 border-4 border-green-500 border-t-transparent rounded-full"
            />
          </div>
        ) : (
          <>
            {/* Tab Navigation */}
            <div className="mb-6 flex gap-4">
              <button
                onClick={() => setActiveTab("dashboard")}
                className={`px-6 py-3 rounded-lg font-rajdhani font-semibold transition-all ${
                  activeTab === "dashboard"
                    ? "bg-gradient-to-r from-green-500/20 to-blue-500/20 border border-green-500/50 text-white"
                    : "bg-white/5 text-gray-400 hover:text-white hover:bg-white/10"
                }`}
              >
                📊 Dashboard
              </button>
              <button
                onClick={() => setActiveTab("registrations")}
                className={`px-6 py-3 rounded-lg font-rajdhani font-semibold transition-all ${
                  activeTab === "registrations"
                    ? "bg-gradient-to-r from-green-500/20 to-blue-500/20 border border-green-500/50 text-white"
                    : "bg-white/5 text-gray-400 hover:text-white hover:bg-white/10"
                }`}
              >
                📋 All Registrations
              </button>
            </div>

            {/* Dashboard Tab */}
            {activeTab === "dashboard" && stats && (
              <motion.div
                initial={{opacity: 0, y: 20}}
                animate={{opacity: 1, y: 0}}
                className="space-y-6"
              >
                {/* Assigned Sports */}
                {stats.assignedSports && stats.assignedSports.length > 0 && (
                  <div className="bg-gradient-to-br from-gray-900/80 to-black/80 backdrop-blur-xl rounded-xl p-6 border border-green-500/20">
                    <h3 className="text-xl font-bold text-white font-rajdhani mb-4">
                      🏆 Assigned Sports
                    </h3>
                    <div className="flex flex-wrap gap-2">
                      {stats.assignedSports.map((sport, index) => (
                        <span
                          key={index}
                          className="px-4 py-2 bg-green-500/10 border border-green-500/30 text-green-400 rounded-lg font-rajdhani"
                        >
                          {sport}
                        </span>
                      ))}
                    </div>
                  </div>
                )}

                {/* Statistics Cards */}
                <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                  {/* Total Registrations */}
                  <motion.div
                    whileHover={{scale: 1.02}}
                    className="bg-gradient-to-br from-gray-900/80 to-black/80 backdrop-blur-xl rounded-xl p-6 border border-blue-500/20"
                  >
                    <div className="flex items-center justify-between">
                      <div>
                        <p className="text-gray-400 text-sm font-rajdhani">Total Registrations</p>
                        <p className="text-3xl font-bold text-white mt-1">
                          {stats.totalRegistrations || 0}
                        </p>
                      </div>
                      <div className="w-12 h-12 bg-blue-500/10 rounded-lg flex items-center justify-center">
                        <span className="text-2xl">📝</span>
                      </div>
                    </div>
                  </motion.div>

                  {/* Status Breakdown */}
                  {stats.byStatus?.map((statusItem, index) => (
                    <motion.div
                      key={index}
                      whileHover={{scale: 1.02}}
                      className="bg-gradient-to-br from-gray-900/80 to-black/80 backdrop-blur-xl rounded-xl p-6 border border-gray-700/20"
                    >
                      <div className="flex items-center justify-between">
                        <div>
                          <p className="text-gray-400 text-sm font-rajdhani capitalize">
                            {statusItem._id} Registrations
                          </p>
                          <p className="text-3xl font-bold text-white mt-1">
                            {statusItem.count}
                          </p>
                        </div>
                        <div className={`w-12 h-12 rounded-lg flex items-center justify-center ${
                          statusItem._id === "confirmed" ? "bg-green-500/10" :
                          statusItem._id === "pending" ? "bg-yellow-500/10" :
                          "bg-red-500/10"
                        }`}>
                          <span className="text-2xl">
                            {statusItem._id === "confirmed" ? "✅" :
                             statusItem._id === "pending" ? "⏳" : "❌"}
                          </span>
                        </div>
                      </div>
                    </motion.div>
                  ))}
                </div>

                {/* Registrations by Event */}
                {stats.byEvent && stats.byEvent.length > 0 && (
                  <div className="bg-gradient-to-br from-gray-900/80 to-black/80 backdrop-blur-xl rounded-xl p-6 border border-gray-700/20">
                    <h3 className="text-xl font-bold text-white font-rajdhani mb-4">
                      🏅 Registrations by Sport
                    </h3>
                    <div className="space-y-3">
                      {stats.byEvent.map((event, index) => (
                        <div
                          key={index}
                          className="flex items-center justify-between p-4 bg-white/5 rounded-lg border border-gray-700/30"
                        >
                          <div>
                            <p className="text-white font-semibold">{event.eventName}</p>
                            <p className="text-sm text-gray-400">{event.category}</p>
                          </div>
                          <div className="text-right">
                            <p className="text-2xl font-bold text-green-400">{event.count}</p>
                            <p className="text-sm text-gray-400">registrations</p>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                {/* Recent Registrations */}
                {stats.recentRegistrations && stats.recentRegistrations.length > 0 && (
                  <div className="bg-gradient-to-br from-gray-900/80 to-black/80 backdrop-blur-xl rounded-xl p-6 border border-gray-700/20">
                    <h3 className="text-xl font-bold text-white font-rajdhani mb-4">
                      🕒 Recent Registrations
                    </h3>
                    <div className="overflow-x-auto">
                      <table className="w-full">
                        <thead>
                          <tr className="border-b border-gray-700">
                            <th className="text-left py-3 px-4 text-gray-400 font-rajdhani">Name</th>
                            <th className="text-left py-3 px-4 text-gray-400 font-rajdhani">Event</th>
                            <th className="text-left py-3 px-4 text-gray-400 font-rajdhani">Status</th>
                            <th className="text-left py-3 px-4 text-gray-400 font-rajdhani">Payment</th>
                            <th className="text-left py-3 px-4 text-gray-400 font-rajdhani">Date</th>
                          </tr>
                        </thead>
                        <tbody>
                          {stats.recentRegistrations.map((reg, index) => (
                            <tr key={index} className="border-b border-gray-800 hover:bg-white/5">
                              <td className="py-3 px-4 text-white">{reg.name}</td>
                              <td className="py-3 px-4 text-gray-300">{reg.eventName}</td>
                              <td className="py-3 px-4">
                                <span className={`px-3 py-1 rounded-full text-xs font-semibold border ${getStatusColor(reg.status)}`}>
                                  {reg.status}
                                </span>
                              </td>
                              <td className="py-3 px-4">
                                <span className={`px-3 py-1 rounded-full text-xs font-semibold border ${getPaymentStatusColor(reg.paymentStatus)}`}>
                                  {reg.paymentStatus || "N/A"}
                                </span>
                              </td>
                              <td className="py-3 px-4 text-gray-400">
                                {new Date(reg.createdAt).toLocaleDateString()}
                              </td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </div>
                )}
              </motion.div>
            )}

            {/* Registrations Tab */}
            {activeTab === "registrations" && (
              <motion.div
                initial={{opacity: 0, y: 20}}
                animate={{opacity: 1, y: 0}}
                className="space-y-6"
              >
                {/* Filters */}
                <div className="bg-gradient-to-br from-gray-900/80 to-black/80 backdrop-blur-xl rounded-xl p-6 border border-gray-700/20">
                  <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <input
                      type="text"
                      placeholder="Search by name, email, phone..."
                      value={filters.search}
                      onChange={(e) => setFilters({...filters, search: e.target.value})}
                      className="px-4 py-2 bg-black/50 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-green-500"
                    />
                    <select
                      value={filters.status}
                      onChange={(e) => setFilters({...filters, status: e.target.value})}
                      className="px-4 py-2 bg-black/50 border border-gray-700 rounded-lg text-white focus:outline-none focus:border-green-500"
                    >
                      <option value="">All Status</option>
                      <option value="pending">Pending</option>
                      <option value="confirmed">Confirmed</option>
                      <option value="cancelled">Cancelled</option>
                    </select>
                    <button
                      onClick={() => {
                        const token = localStorage.getItem("coordinatorToken");
                        if (token) fetchRegistrations(token);
                      }}
                      className="px-6 py-2 bg-gradient-to-r from-green-500 to-blue-500 text-white font-bold rounded-lg hover:shadow-lg transition-all"
                    >
                      Apply Filters
                    </button>
                  </div>
                </div>

                {/* Registrations Table */}
                <div className="bg-gradient-to-br from-gray-900/80 to-black/80 backdrop-blur-xl rounded-xl p-6 border border-gray-700/20">
                  <h3 className="text-xl font-bold text-white font-rajdhani mb-4">
                    All Sports Registrations
                  </h3>
                  {registrations.length > 0 ? (
                    <div className="overflow-x-auto">
                      <table className="w-full">
                        <thead>
                          <tr className="border-b border-gray-700">
                            <th className="text-left py-3 px-4 text-gray-400 font-rajdhani">Name</th>
                            <th className="text-left py-3 px-4 text-gray-400 font-rajdhani">Email</th>
                            <th className="text-left py-3 px-4 text-gray-400 font-rajdhani">Phone</th>
                            <th className="text-left py-3 px-4 text-gray-400 font-rajdhani">Event</th>
                            <th className="text-left py-3 px-4 text-gray-400 font-rajdhani">Institution</th>
                            <th className="text-left py-3 px-4 text-gray-400 font-rajdhani">Status</th>
                            <th className="text-left py-3 px-4 text-gray-400 font-rajdhani">Date</th>
                          </tr>
                        </thead>
                        <tbody>
                          {registrations.map((reg, index) => (
                            <tr key={index} className="border-b border-gray-800 hover:bg-white/5">
                              <td className="py-3 px-4 text-white">{reg.name}</td>
                              <td className="py-3 px-4 text-gray-300">{reg.email}</td>
                              <td className="py-3 px-4 text-gray-300">{reg.phone}</td>
                              <td className="py-3 px-4 text-gray-300">{reg.eventName}</td>
                              <td className="py-3 px-4 text-gray-300">{reg.institution || "N/A"}</td>
                              <td className="py-3 px-4">
                                <span className={`px-3 py-1 rounded-full text-xs font-semibold border ${getStatusColor(reg.status)}`}>
                                  {reg.status}
                                </span>
                              </td>
                              <td className="py-3 px-4 text-gray-400">
                                {new Date(reg.createdAt).toLocaleDateString()}
                              </td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  ) : (
                    <p className="text-center text-gray-400 py-8">No registrations found</p>
                  )}
                </div>
              </motion.div>
            )}
          </>
        )}
      </div>
    </div>
  );
};

export default CoordinatorDashboard;
